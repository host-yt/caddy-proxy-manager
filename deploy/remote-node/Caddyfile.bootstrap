# Bootstrap config for a remote Caddy node.
# After the control plane registers this node and POSTs /load, this file
# is superseded by the JSON config pushed via the Admin API.

{
	# 0.0.0.0 here is the CONTAINER's namespace, not the host: the compose file
	# publishes this port on host loopback only and the node-agent fronts it
	# with authentication (SEC-002). A WireGuard IP cannot be bound here at all
	# - it lives on the host, outside this container's netns.
	admin 0.0.0.0:2019

	email {$ACME_EMAIL}

	on_demand_tls {
		ask {$ASK_ENDPOINT_URL}
	}
}

:80 {
	respond "Hostyt Proxy node - awaiting routes from control plane" 503
}
